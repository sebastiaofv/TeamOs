{
  "concurrency": 1,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low": {
      "code": "codex"
    },
    "medium": {
      "code": "codex"
    },
    "high": {
      "code": "codex"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "claude-balanced",
      "ui": "codex"
    },
    "security": {
      "security": "claude-strong"
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    "factory/lib/*",
    "factory/prompts/*",
    "factory/tests/*",
    "factory/dashboard.html",
    ".agents/skills/factory/*",
    ".claude/skills/factory/*"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "step_timeout_seconds": 1800,
  "check_timeout_seconds": 1800,
  "profiles": {
    "claude-fast": {
      "cli": "claude",
      "model": "haiku"
    },
    "claude-balanced": {
      "cli": "claude",
      "model": "sonnet"
    },
    "claude-strong": {
      "cli": "claude",
      "model": "opus"
    },
    "codex": {
      "cli": "codex",
      "model": null,
      "reasoning_effort": null
    }
  },
  "steps": {
    "intake": "claude-fast",
    "spec-writer": "codex",
    "builder": "claude-strong",
    "approver": "codex"
  }
}
