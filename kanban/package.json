{
  "name": "teamos-kanban",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons:generate && vite build",
    "build:standalone": "npm run icons:generate && vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test:unit": "vitest run",
    "bench:project-files": "node scripts/benchmark-project-files.mjs",
    "bench:performance": "node scripts/benchmark-performance.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "prepare": "cd .. && husky kanban/.husky",
    "icons:generate": "node scripts/generate-select-icons.mjs",
    "example:generate": "node scripts/example-project/generate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.52.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15",
    "lucide-react": "^1.72.0"
  }
